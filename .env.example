# Copy this file to .env.local (local) or set the same names in the host's environment (production). Never commit real values.

# ---- Public address (REQUIRED in production) --------------------------------------------------
# Used for canonical links, hreflang, robots.txt and the sitemap. Without it they say http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---- Firebase (REQUIRED): sign-in ------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# The service account JSON of the project, on ONE line (server only).
FIREBASE_ADMIN_KEY=

# ---- MongoDB (REQUIRED): profiles, resumes, files, rate limits -------------------------------
MONGODB_USER=
MONGODB_PASS=
# Optional: they default to the course cluster, so set both for your own database.
MONGODB_HOST=
MONGODB_DB=

# ---- AI provider (REQUIRED): any OpenAI-compatible API, Gemini by default ---------------------
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.5-flash-lite
# Optional stronger model for judging and rewriting resumes and cover letters (falls back to AI_MODEL).
# AI_MODEL_STRONG=

# ---- Job search (optional) --------------------------------------------------------------------
# Adzuna adds jobs by city in many countries. Without these the other sources still work.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Running the site (optional, but see the notes) --------------------------------------------
# Emails (comma separated) that may read the contact messages at /home/admin/messages.
ADMIN_EMAILS=
# A Slack, Discord or Teams incoming webhook that gets a short note for every contact message.
CONTACT_WEBHOOK_URL=
# Secret (16+ characters) for the retention cleanup: POST /api/admin/cleanup with "Authorization: Bearer <this value>", for example once a day.
# The cleanup also runs by itself, at most once an hour, whenever someone starts a guest session, so this is a safety net for quiet days.
CRON_SECRET=

# USAJOBS (federal jobs of the United States): free key at developer.usajobs.gov and the email it was requested with
USAJOBS_API_KEY=
USAJOBS_EMAIL=
